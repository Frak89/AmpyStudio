<svg xmlns="http://www.w3.org/2000/svg" xmlns:ampy="https://ampybios.example/ns/jsvg/1" viewBox="0 0 640 360" width="640" height="360" ampy:version="1.0">
<title>AmpyStudio — JSVG example</title><desc>Alien HMI glyph and notification panel. Embedded project data.</desc>
<metadata id="ampy-project"><ampy:project media-type="application/json"><![CDATA[{
  "format": "AmpyJSVG",
  "version": "1.0",
  "canvas": {
    "width": 640,
    "height": 360
  },
  "objects": [
    {
      "id": "glyph01",
      "type": "glyph",
      "geometry": {
        "radius": 8,
        "strokeWidth": 3,
        "mode": "fillet",
        "paths": {
          "standby": "M0 -42 Q4 -42 8 -34 L40 22 Q44 30 35 30 H-35 Q-44 30 -40 22 L-8 -34 Q-4 -42 0 -42 Z",
          "active": "M0 -42 Q8 -42 16 -36 L36 -20 Q44 -16 44 -8 V8 Q44 16 36 20 L16 36 Q8 42 0 42 Q-8 42 -16 36 L-36 20 Q-44 16 -44 8 V-8 Q-44 -16 -36 -20 L-16 -36 Q-8 -42 0 -42 Z"
        }
      },
      "transform": {
        "x": 320,
        "y": 112,
        "rotation": 0
      },
      "material": {
        "stroke": "#d9c58d",
        "fill": "#203a32",
        "glow": 3
      },
      "extrusion": {
        "depth": 24
      },
      "physics": {
        "mass": 1,
        "stiffness": 120,
        "damping": 18
      },
      "animation": {
        "type": "morph",
        "durationMs": 850,
        "easing": "smooth",
        "from": "standby",
        "to": "active"
      },
      "tag": {
        "name": "DB_Core.Running",
        "type": "Bool",
        "access": "read",
        "simulation": true
      }
    },
    {
      "id": "message01",
      "type": "popup",
      "geometry": {
        "radius": 14
      },
      "animation": {
        "type": "genie",
        "source": "glyph01",
        "durationMs": 850
      },
      "tag": {
        "name": "DB_Alarm.Warning",
        "type": "Bool",
        "access": "read",
        "simulation": true
      }
    }
  ],
  "connections": [
    {
      "source": "glyph01",
      "target": "message01",
      "type": "bezier"
    }
  ],
  "events": [
    {
      "trigger": "click",
      "source": "glyph01",
      "actions": [
        {
          "type": "toggleMorph",
          "target": "glyph01"
        },
        {
          "type": "togglePopup",
          "target": "message01"
        }
      ]
    },
    {
      "trigger": "tagChange",
      "tag": "DB_Alarm.Warning",
      "equals": true,
      "actions": [
        {
          "type": "showPopup",
          "target": "message01"
        }
      ]
    }
  ],
  "timeline": {
    "durationMs": 850,
    "tracks": [
      {
        "target": "glyph01",
        "property": "morphProgress",
        "keyframes": [
          {
            "timeMs": 0,
            "value": 0
          },
          {
            "timeMs": 850,
            "value": 1
          }
        ]
      }
    ]
  },
  "runtime": {
    "mode": "simulation",
    "externalDependencies": []
  }
}]]></ampy:project></metadata>
